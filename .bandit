# Bandit configuration for GWorkspace Agent (YAML format).
# Bandit's `-c` flag expects YAML; the previous INI-style header was silently
# ignored. See: https://bandit.readthedocs.io/en/latest/config.html
#
# Test directories are excluded because test assertions are intentional and
# not security risks.

exclude_dirs:
  - venv
  - tests
  - dist
  - build
  - .git
  - __pycache__

# Skip B601 (paramiko_calls) — not used in this project.
skips:
  - B601

# B101 (assert_used) — only skip in test files; enforce assertions elsewhere.
assert_used:
  skips:
    - "*_test.py"
    - "*/test_*.py"
    - "*/tests/*"
